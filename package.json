    "start": "node build_gita.mjs",
    "dev": "npx http-server . -p 3000 -c-1 --cors"
  },
  "keywords": [
    "bhagavad-gita",
    "gita",
    "sanskrit",
    "hindi",
    "english",
    "transliteration",
    "dataset",
    "json"
  ],
